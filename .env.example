# Copy to .env and adjust. docker compose reads these values; `python app.py` does too.

# GeoDataHub backend that receives "Upload to project" (must match the frontend's backend)
API_BASE_URL=https://dev-backend.geodatahub.ch

# Coordinate system preselected when nothing better is known (2056 = Swiss LV95)
DEFAULT_EPSG=2056

# Origins allowed to call /api/* from a browser and to embed this page (comma separated)
# CORS_ORIGINS=http://localhost:3000,https://dev.geodatahub.ch,https://www.geodatahub.ch

# Session signing key. Leave empty to generate a random one at start-up.
SECRET_KEY=

# Limits and housekeeping
MAX_UPLOAD_MB=500
MAX_PARALLEL_JOBS=2
JOB_TTL_HOURS=24

# Ground height suggestions for control points: all | swisstopo | off
# ("all" also asks OpenTopoData for locations outside Switzerland)
ELEVATION_LOOKUP=all

# Local development only (python app.py)
HOST=127.0.0.1
PORT=5002
FLASK_DEBUG=0
